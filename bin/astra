#!/usr/bin/env sh
# astra — one entry point for the posture, for both the CLI and the desktop
# app's own Codex.
#
# Why this exists rather than a configuration file alone: the ChatGPT desktop
# app **rewrites `$CODEX_HOME/config.toml` from scratch on every launch**,
# discarding any key it did not write (measured twice; see
# docs/measurements.md). A posture that lives only in that file survives until
# the next time the app starts, and no longer.
#
# So the posture is carried on the command line, where nothing can overwrite it,
# and the file the app owns is left exactly as the app wants it -- which is what
# keeps browser use working.
#
# **Scope: two things are settled so far, the autonomy posture and the context
# window. Nothing else is set here on purpose.**
#
# Usage:
#   astra [codex args...]              full auto, 872000 window
#   astra --safe [codex args...]       same, but keep the workspace-write sandbox
#   astra exec "prompt"                one-shot, same posture
#   ASTRA_CONTEXT=272000 astra         stay under the price cliff for one run
#
# Anything after the flags is passed through to `codex` untouched.

set -eu

CODEX_BIN="${ASTRA_CODEX_BIN:-codex}"

# 872000 is this account's `max_context_window`, of which 95% -- 828400 -- is
# usable. 1M does not exist here; that figure is the API model's window.
# 700000 leaves 128400 tokens of headroom under it.
CONTEXT="${ASTRA_CONTEXT:-872000}"
COMPACT="${ASTRA_COMPACT:-700000}"

# `never` + `danger-full-access` is precisely what `--yolo` sets, verified by
# comparing session headers. `--full-auto` was removed at 0.155.1 and
# `--skip-permissions` never existed here, so neither is used.
SANDBOX="danger-full-access"

case "${1:-}" in
  --safe)
    shift
    SANDBOX="workspace-write"
    ;;
esac

# Note the `model_` prefix on the compaction key. `auto_compact_token_limit`
# without it is a model-catalog field, not a config key: `--strict-config`
# rejects it, and an ordinary run accepts it silently and does nothing.
exec "$CODEX_BIN" \
  -c model='"gpt-6-astra"' \
  -c approval_policy='"never"' \
  -c sandbox_mode="\"$SANDBOX\"" \
  -c model_context_window="$CONTEXT" \
  -c model_auto_compact_token_limit="$COMPACT" \
  "$@"
